# =================================================================
# Backend Environment Variables Specification
# =================================================================

# MongoDB Database Connection (Atlas M0 Cluster URI & DB Name)
MONGO_URL=mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DB_NAME=voice_agent

# Speech-to-Text (STT) - Deepgram API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Text-to-Speech (TTS) - ElevenLabs API Key & Voice ID
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# LLM Inference - Groq API Key & Model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# RAG & Embedding Service (BAAI/BGE-M3)
AICREDITS_API_KEY=your_aicredits_api_key_here
AICREDITS_BASE_URL=https://aicredits.in/v1
EMBEDDING_MODEL=baai/bge-m3

# CORS Security & Multi-Tenancy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TENANT_ID=mvp_tenant
